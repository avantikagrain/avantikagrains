# ---------------------------------------------------------------------------
# Avantika Grains — environment configuration
#
# Copy to .env.local for development. NEVER commit a filled-in copy.
# Use separate credentials for development, staging and production.
# Every variable below is validated at startup by src/lib/env.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- URLs ------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated. Must be set explicitly in production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# Use a least-privilege Atlas user: readWrite on this database only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=avantika_grains_dev

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=<generate-a-48-byte-random-string>
JWT_REFRESH_SECRET=<generate-a-different-48-byte-random-string>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Leave empty in development; set to .avantikagrains.com in production.
COOKIE_DOMAIN=

# --- Payments: Razorpay ----------------------------------------------------
# Keep test keys (rzp_test_*) until merchant onboarding is complete.
#
# For local development WITHOUT a Razorpay account, replace the placeholders
# below with any non-empty values (e.g. rzp_test_unconfigured). Browsing, the
# catalogue and the cart all work; only the payment step needs real keys.
# Anything left in <angle brackets> is rejected at startup by design.
RAZORPAY_KEY_ID=rzp_test_<your-test-key-id>
RAZORPAY_KEY_SECRET=<your-test-key-secret>
# From the Razorpay dashboard webhook configuration screen.
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>
# Guarded: setting true with an rzp_test_* key will refuse to boot.
PAYMENTS_LIVE_MODE=false

# --- Shipping: Shiprocket --------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# --- Media storage ---------------------------------------------------------
# On a platform with an ephemeral filesystem (Vercel and similar), uploads
# written locally are lost on every deploy. In production either use s3 / r2,
# or keep local and set CDN_BASE_URL to a persistent origin.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# --- Email -----------------------------------------------------------------
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=

# --- Commerce --------------------------------------------------------------
COD_ENABLED=true

# Require a signed-in account to place an order. When false, guests may
# order with a complete name, mobile, email and delivery address.
REQUIRE_ACCOUNT_FOR_ORDERS=false

# --- Public site details ---------------------------------------------------
# These are inlined into the browser bundle at build time, so they must hold
# nothing secret. Leave NEXT_PUBLIC_WHATSAPP_NUMBER empty to hide the chat
# launcher and every WhatsApp link until a real number is available.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_TRADING_NAME=
# Pipe-separated address lines, e.g. "Depalpur|Indore, Madhya Pradesh|453115"
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_BUSINESS_HOURS=

# Search engines are kept out until this is explicitly set to true.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
